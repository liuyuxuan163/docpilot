# DocPilot 环境变量示例
#
# 用法：复制为 .env，只填你实际需要的那几行。.env 已在 .gitignore 里，Key 不会进库。
# ★ 什么都不配也能跑 —— 默认 Mock（离线、确定性、可完整演示与跑评测）。
#
# 优先级（高 → 低）：
#     命令行 --provider/--model  >  真实环境变量  >  .env  >  configs/docpilot.yaml
#
# 两种接真实模型的方式，区别只在于"影响范围"：
#
#   方案 A（推荐）打开方式：provider 保持 mock，需要时在命令行切一次
#       python -m docpilot ask "年假能结转到明年吗" --provider deepseek
#       → 只有这一次调真实接口；pytest / eval / demo / mcp 仍然离线，不会意外花钱
#
#   方案 B：把 DOCPILOT_PROVIDER 改成 deepseek（即下面那行）
#       → **所有**命令都走真实接口，包括 eval（会真花钱、且指标不再可复现）
#         pytest 不受影响：tests/conftest.py 里已把 provider 钉死为 mock
#
# 支持的语法（见 docpilot/core.py::parse_dotenv）：
#   KEY=VALUE、# 注释（整行或值后面的"空白+#"）、空行、export KEY=VALUE、
#   成对引号（值里有空格或 # 时用）。不支持多行值与变量插值。

# ── 1. 默认：离线 Mock（建议保持） ──────────────────────────────────────
DOCPILOT_PROVIDER=mock

# ── 2. 模型名 ──────────────────────────────────────────────────────────
# DeepSeek 公共 API 常见取值：deepseek-chat / deepseek-reasoner
DOCPILOT_MODEL=deepseek-chat

# ── 3. API Key：只填一个，别重复写 ─────────────────────────────────────
# 优先级：DOCPILOT_API_KEY > DEEPSEEK_API_KEY > OPENAI_API_KEY
# 同一个 Key 写在两个变量里不会报错，但轮换时极容易漏改一处 —— 只留一个。
# 没有 Key 时系统会自动降级为 Mock 并提示，而不是直接报错。
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DOCPILOT_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 4. 自定义网关（vLLM / One-API / 内网代理 / 自建 embedding 网关）─────
# ⚠ 变量名必须是 DOCPILOT_BASE_URL。写成 base_url= 会被**静默忽略**
#   （不报错，但也不会生效 —— 这类"格式看着对、其实没被读"的坑已踩过一次）。
# deepseek 不填时自动使用 https://api.deepseek.com/v1（带 /v1）
# DOCPILOT_BASE_URL=https://api.deepseek.com/v1

# ── 5. MCP 服务端绑定的角色（见 python -m docpilot mcp --role）──────────
# DOCPILOT_MCP_ROLE=public
