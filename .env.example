# DocPilot 环境变量示例
#
# 用法：复制为 .env 并填入真实值；或直接 export 到环境变量。
# ★ 完全不配置也能跑 —— 默认走 Mock 模式（离线、确定性、可完整演示与评测）。

# ── 模型提供方：mock | deepseek | openai | openai_compat ────────────────
# 设成 mock（或留空）时，系统使用内置的确定性引擎，不调用任何外部接口。
DOCPILOT_PROVIDER=mock

# 使用的模型名
DOCPILOT_MODEL=deepseek-chat

# ── API Key（按提供方选一个填） ────────────────────────────────────────
# 优先级：DOCPILOT_API_KEY > DEEPSEEK_API_KEY > OPENAI_API_KEY
# 注意：**没有 Key 时系统会自动降级为 Mock 并提示，而不是直接报错**，
#       这样"新同学 clone 完三分钟能跑起来"的体验才成立。
# DOCPILOT_API_KEY=sk-xxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx

# ── 自定义网关地址（接 vLLM / One-API / 内网代理时用） ─────────────────
# DOCPILOT_BASE_URL=http://127.0.0.1:8000/v1

# ── Web 演示端口（默认 8020） ──────────────────────────────────────────
# DOCPILOT_WEB_PORT=8020
